    "manager": [
      "workspace:read",
      "member:invite",
      "agent:assign",
      "skill:read",
      "skill:propose",
      "skill:approve",
      "skill:update",
      "skill:invoke",
      "memory:read",
      "memory:write_draft",
      "memory:promote",
      "wiki:read",
      "model:use_laf"
