# Hosted LAF Office control plane.
# Copy this file to .env.local for local Vercel/API development, and mirror the
# production values into Vercel environment variables before deployment.
# Replace <your-project-ref> with your own Supabase project ref.
# See docs/specs/HOSTED-DEPLOYMENT-RUNBOOK.md for setup.
# `npm run hosted-env:preflight` reads .env and .env.local automatically;
# exported shell or CI variables override values in these files.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical hosted web origin used for setup codes and absolute URLs.
# Required in production to prevent Host-header injection and preview-domain drift.
LAF_OFFICE_PUBLIC_HOST=

# Optional server-side canonical API base for split-origin deployments.
# Leave empty for same-origin Vercel /api rewrites.
LAF_OFFICE_PUBLIC_API_BASE_URL=

# Optional browser API base for split-origin deployments.
# Leave empty for same-origin Vercel /api rewrites.
VITE_LAF_API_BASE_URL=

# Comma-separated CORS origin allowlist (e.g. "https://app.example.com").
# Leave empty if the API is served same-origin via Vercel rewrites.
LAF_OFFICE_ALLOWED_ORIGINS=
