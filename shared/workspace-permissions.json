{
  "version": "workspace-permissions.v1",
  "roles": ["owner", "admin", "manager", "member", "viewer"],
  "permissions": [
    "workspace:read",
    "workspace:manage",
    "member:invite",
    "member:manage_roles",
    "member:manage_permissions",
    "agent:create",
    "agent:update",
    "agent:assign",
    "skill:read",
    "skill:propose",
    "skill:create_active",
    "skill:approve",
    "skill:update",
    "skill:archive",
    "skill:invoke",
    "memory:read",
    "memory:write_draft",
    "memory:promote",
    "memory:write_canonical",
    "wiki:read",
    "model:use_laf",
