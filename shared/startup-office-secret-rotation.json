{
  "version": "startup-office-secret-rotation.v1",
  "review_cadence_days": 30,
  "emergency_rotation_triggers": [
    "suspected credential exposure",
    "departing operator with production access",
    "provider dashboard breach or suspicious usage",
    "failed secret scan on a deploy branch"
  ],
  "secret_inventory": [
    {
      "name": "SUPABASE_SERVICE_ROLE_KEY",
      "owner": "platform operator",
      "rotation_cadence_days": 90,
      "blast_radius": "database service-role writes, worker claims, and admin repair actions"
    },
    {
      "name": "SUPABASE_ANON_KEY",
      "owner": "platform operator",
      "rotation_cadence_days": 180,
      "blast_radius": "public client auth and PostgREST access"
    },
    {
      "name": "LAF_OFFICE_OPENAI_API_KEY",
      "owner": "ai operator",
      "rotation_cadence_days": 90,
      "blast_radius": "Startup Office managed model execution"
    },
    {
      "name": "OPENAI_API_KEY",
      "owner": "ai operator",
      "rotation_cadence_days": 90,
      "blast_radius": "fallback OpenAI-compatible model execution"
    },
    {
      "name": "RESEND_API_KEY",
      "owner": "support operator",
      "rotation_cadence_days": 90,
      "blast_radius": "external email delivery"
    },
    {
      "name": "LAF_SYNTHETIC_PASSWORD",
      "owner": "release operator",
      "rotation_cadence_days": 30,
      "blast_radius": "dedicated synthetic monitor account only"
    }
  ],
  "config_inventory": [
    "LAF_OFFICE_PUBLIC_HOST",
    "LAF_OFFICE_ALLOWED_ORIGINS",
    "LAF_OFFICE_BILLING_MODE",
    "LAF_OUTBOX_EMAIL_PROVIDER",
    "LAF_OFFICE_STARTUP_OFFICE_AI_PROVIDER",
    "LAF_OFFICE_STARTUP_OFFICE_MODEL",
    "LAF_OFFICE_MODEL_PRICING_JSON"
  ],
  "post_rotation_verification": [
    "npm run hosted-env:preflight -- --no-env-file",
    "npm run startup-office:ops-monitor",
    "npm run startup-office:synthetic-monitor",
    "npm run beta:release-gate"
  ],
  "forbidden_records": [
    "raw secret values",
    "provider token fragments",
    "customer private data",
    "payment instruments"
  ]
}
